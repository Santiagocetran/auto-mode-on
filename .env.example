# Halketon backend (apps/api) — see docs/architecture/overview.md §9.
# Copy to apps/api/.env and fill in. Never commit real secrets.

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (OpenAI GPT-4o-mini)
OPENAI_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exact public base URL the Twilio Sandbox webhook points at (NO trailing slash),
# e.g. https://abc123.ngrok.io — used to rebuild the URL for signature validation.
PUBLIC_WEBHOOK_BASE_URL=

# Local-dev only: set true to bypass Twilio signature validation. Never set in prod.
SKIP_TWILIO_SIGNATURE_VALIDATION=false

# Shared secret so only the n8n cron can call POST /reminders/run
REMINDER_TRIGGER_SECRET=

# --- Legacy TS prototype (src/, reference-only per ADR 0010) ---
PORT=3000
