# Copiar a deploy/.env antes de levantar el stack:
#   cp deploy/.env.example deploy/.env
#
# Credenciales del proyecto Supabase remoto (Settings → API).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- API (FastAPI) — opcionales ---
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URL pública donde Twilio envía el webhook (sin barra final).
# Debe coincidir con el dominio configurado en Twilio + /whatsapp
# Ej. Coolify: https://api.tudominio.com  |  ngrok: https://abc123.ngrok-free.app
PUBLIC_WEBHOOK_BASE_URL=

# Solo dev local con túnel. Nunca true en prod/Coolify.
SKIP_TWILIO_SIGNATURE_VALIDATION=false

REMINDER_TRIGGER_SECRET=local-dev-reminder-secret

# --- Dashboard ---
DEMO_ORG_SLUG=fundacion-esperanza
