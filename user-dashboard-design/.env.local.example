# Copiar a .env.local y completar con tu proyecto Supabase.

# Activa lecturas live (sin esto usa mock-data.ts)
DATA_SOURCE=supabase

# Supabase REST
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Obligatorio para lecturas server-side (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Si aun así ves "permission denied for table ...": el backend debe ejecutar GRANT SELECT
# para service_role en Supabase SQL editor (no es un fix de frontend).

# Organización demo mientras no hay auth (default: fundacion-esperanza del seeds.sql)
DEMO_ORG_SLUG=fundacion-esperanza
# DEMO_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
# Usuario demo (Laura owner): aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# DEMO_USER_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
